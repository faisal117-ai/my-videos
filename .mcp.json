{
  "mcpServers": {
    "atlascloud": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "atlascloud-mcp"
      ],
      "env": {
        "ATLASCLOUD_API_KEY": "proxy-injected"
      }
    },
    "sync": {
      "type": "http",
      "url": "https://mcp.sync.so/mcp"
    }
  }
}