   ],
   "cards": [
    {
     "line": 1,
     "q": "34:14",
     "w": [
      1,
      13
     ],
     "en": "nothing indicated to the jinn his death except a creature of the earth eating his staff"
    },
    {
     "line": 4,
     "q": "34:14",
     "w": [
      14,
      27
     ],
     "en": "it became clear to the jinn that if they had known the unseen, they would not have remained in humiliating punishment"
    }
   ],
   "scene": "photos"
  },
  {
   "title": "The Lesson",
   "photos": [
