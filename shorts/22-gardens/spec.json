  "beats": [
    {
      "hook": true,
      "text": "He said his garden would never die…",
      "sub": "…by morning, it was gone.",
      "ur": "اس نے کہا میرا باغ کبھی ختم نہیں ہو گا… صبح تک وہ اجڑ چکا تھا",
      "reveal": false,
      "mood": {
        "warm": 0.12,
        "cool": 0
      }
    },
    {
      "text": "*One sentence* he forgot to say… could have saved everything.",
      "ur": "ایک جملہ جو وہ کہنا بھول گیا… سب کچھ بچا سکتا تھا",
      "mood": {
        "warm": 0.12,
        "cool": 0
      }
    },
    {
      "text": "Two gardens of *grapevines*, bordered with palm trees.",
      "ur": "انگور کے دو باغ، جن کے گرد کھجور کے درخت تھے",
      "ref": "Al-Kahf 18:32",
      "mood": {
        "warm": 0.12,
        "cool": 0
      }
    },
    {
      "text": "He walked in, *proud* of all he had…",
      "ur": "وہ اپنی دولت پر فخر کرتا ہوا باغ میں داخل ہوا",
      "mood": {
        "warm": 0.12,
        "cool": 0
      }
    },
    {
      "q": "18:35",
      "ar_words": [
        6,
        12
      ],
      "en": "I do not think that this will perish - ever",
      "ur_q": "میں نہیں سمجھتا کہ یہ دولت کبھی فنا ہو جائے گی",
      "ref": "Al-Kahf 18:35",
      "mood": {
        "warm": 0.12,
        "cool": 0
      },
      "arabic": "قَالَ مَآ أَظُنُّ أَن تَبِيدَ هَٰذِهِۦٓ أَبَدࣰا",
      "translation": "“I do not think that this will perish - ever”",
      "ur": "میں نہیں سمجھتا کہ یہ دولت کبھی فنا ہو جائے گی"
    },
    {
      "text": "His friend reminded him of that *one sentence*… he did not listen.",
      "ur": "اس کے دوست نے اسے وہ جملہ یاد دلایا… مگر اس نے نہ سنا",
      "ref": "Al-Kahf 18:39",
      "mood": {
        "warm": 0.12,
        "cool": 0
      }
    },
    {
      "text": "That night… his fruit was *destroyed*.",
