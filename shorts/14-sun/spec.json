  "beats": [
    {
      "hook": true,
      "text": "Allah stopped the *sun*…",
      "sub": "…for one man.",
      "ur": "اللہ نے سورج روک دیا… ایک شخص کے لیے",
      "mood": {
        "warm": 0.4,
        "cool": 0
      },
      "reveal": false
    },
    {
      "text": "A prophet marched his army to a city… as the sun was about to *set*.",
      "size": 100,
      "ur": "ایک نبی اپنا لشکر لے کر ایک شہر کی طرف بڑھے… جب سورج ڈوبنے کو تھا",
      "ref": "Sahih al-Bukhari 3124",
      "mood": {
        "warm": 0.5,
        "cool": 0
      }
    },
    {
      "text": "“You are *commanded*, and I am commanded.”",
      "ur": "تو بھی حکم کا پابند ہے، اور میں بھی حکم کا پابند ہوں",
      "ref": "Sahih al-Bukhari 3124",
      "mood": {
        "warm": 0.5,
        "cool": 0.1
      }
    },
    {
      "text": "“O Allah, hold it *back* for us.”",
      "size": 124,
      "ur": "اے اللہ، اسے ہمارے لیے روک دے",
      "ref": "Sahih al-Bukhari 3124",
      "mood": {
        "warm": 0.6,
        "cool": 0.2
      }
    },
    {
      "text": "And the sun was held back… until Allah gave them *victory*.",
      "ur": "اور سورج روک دیا گیا… یہاں تک کہ اللہ نے انہیں فتح دی",
      "ref": "Sahih al-Bukhari 3124",
      "mood": {
        "warm": 0.7,
        "cool": 0.2
      }
    },
    {
      "cta": true,
      "text": "Follow for more.",
      "ur": "فالو کریں",
